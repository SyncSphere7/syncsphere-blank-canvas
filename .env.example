# Copy to .env.local for local development. On Vercel, set these under
# Project -> Settings -> Environment Variables. Never commit real values.

# --- Resend: contact form, website grader leads, payment notifications ---
# The syncspherellc.com sending domain must be verified in Resend.
RESEND_API_KEY=

# --- Flutterwave: online deposits and invoice payments (/pay) ---
# Leave these empty until the merchant account is approved; /pay then shows
# a "contact us to pay" message instead of a checkout button.
FLW_SECRET_KEY=
# Any long random string. Used to sign payment references so the amount
# cannot be tampered with between checkout and verification.
PAYMENT_SIGNING_SECRET=
# The "Secret hash" you set in Flutterwave Dashboard -> Settings -> Webhooks.
# Webhook URL to register there: https://www.syncspherellc.com/api/pay/webhook
FLW_WEBHOOK_HASH=
