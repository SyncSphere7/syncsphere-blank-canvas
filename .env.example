# ---------------------------------------------------------------------------
# Resend — REQUIRED for the contact form (api/contact.js)
# ---------------------------------------------------------------------------
# Without this the contact form returns HTTP 500 and no enquiry is delivered.
# Set it in Vercel -> Project -> Settings -> Environment Variables, and make
# sure the syncspherellc.com sending domain is verified in the Resend dashboard.
RESEND_API_KEY=your_resend_api_key_here

# ---------------------------------------------------------------------------
# OpenRouter — used by the optional AI chat assistant
# ---------------------------------------------------------------------------
# This key is compiled into the client bundle, so it MUST be a restricted,
# spend-capped key. Never use an unrestricted key here.
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Instructions:
# 1. Copy this file to .env for local development
# 2. Replace the placeholders with your actual API keys
# 3. Never commit the .env file to version control (it is already gitignored)
# 4. OpenRouter key: https://openrouter.ai/keys
# 5. Resend key: https://resend.com/api-keys

